# Production: your exact HTTPS origin, without a trailing slash.
PUBLIC_ORIGIN=https://vpn.example.com
# Generate with: npm run password:hash
ADMIN_PASSWORD_HASH=
# Tailscale API access token (scopes: devices:core and devices:routes); never expose with VITE_.
TAILSCALE_API_KEY=
# Local development: PUBLIC_ORIGIN=http://localhost:3000 and NODE_ENV=development
NODE_ENV=production
HOST=127.0.0.1
PORT=3001
# True only behind ONE trusted local Nginx/Caddy proxy that overwrites X-Forwarded-For
# or appends the real client IP last. Do not expose the backend directly.
TRUST_PROXY=false
